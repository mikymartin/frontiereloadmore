# Include this static TypoScript AFTER frontieretema and news.
[{$plugin.tx_frontiereloadmore.enabled}]
plugin.tx_news {
    view.partialRootPaths.30 = EXT:frontiereloadmore/Resources/Private/Partials/News/
    settings {
        hidePagination = 0
        list.paginate.itemsPerPage = {$plugin.tx_frontiereloadmore.itemsPerPage}
        loadMore.enabled = 1
        loadMore.showCount = {$plugin.tx_frontiereloadmore.showCount}
    }
}

[/]
